# .env.example — 三機共用的變數骨架（單一真相來源）
#
# 填法：cp .env.example .env && chmod 600 .env，再逐項填值。
#   這份檔案**不含任何真實憑證**，可安全進版控。
#
# 機台差異怎麼填：
#   共用變數直接寫；某一台獨有的加前綴（msi_ / mbp_ / x570_），
#   例如只有 MSI 要設的雲端金鑰：msi_NVIDIA_API_KEY=...。
#   程式端用 ${VAR_名} 讀取時會自動去掉前綴。
#
# ⚠️ 一律 chmod 600：這個檔案有憑證。

# ── TS_IP（必填；消費者：compose/backend/scripts）
#   tailscale IP。compose 用它綁 6333/5432；腳本算 dest URL
TS_IP=

# ── HOST_ID（必填；消費者：compose/backend）
#   registry 主鍵，也是前端切換鍵值：x570 / mbp / msi
HOST_ID=

# ── HOST_NAME（必填；消費者：compose/backend）
#   取代 /etc/hostname 單檔 bind mount（Docker Desktop 會 exit=127）
HOST_NAME=

# ── HOST_MACHINE_ID（必填；消費者：compose/backend）
#   取代 /etc/machine-id 單檔 bind mount。32 字元 hex
HOST_MACHINE_ID=

# ── COLLECTION（選填；消費者：compose/backend/scripts）
#   qdrant collection 名，預設 laws
COLLECTION=

# ── POSTGRES_PASSWORD（必填；消費者：compose）
#   compose 用 :? 語法，缺值直接拒絕啟動。勿用 changeme
POSTGRES_PASSWORD=

# ── POSTGRES_DSN（選填；消費者：compose/backend/scripts）
#   備援機要指 x570 的 registry；x570 本機留空走 compose 預設
POSTGRES_DSN=

# ── QDRANT_API_KEY（必填；消費者：compose/backend/scripts）
#   本機自己的 qdrant。開了認證就必填
QDRANT_API_KEY=

# ── QDRANT_PEER_API_KEY（選填；消費者：scripts）
#   同步對象（x570）的 key。不設則退回 QDRANT_API_KEY
QDRANT_PEER_API_KEY=

# ── LLM_MODEL（選填；消費者：compose/backend）
LLM_MODEL=

# ── OLLAMA_URLS（選填；消費者：compose/backend）
OLLAMA_URLS=

# ── OLLAMA_MODELS（選填；消費者：backend）
#   與 OLLAMA_URLS 同順序對應各機的 LLM model
OLLAMA_MODELS=

# ── SRC_API_URL（選填；消費者：scripts）
#   來源機 api base，取法規版本用。8000 綁 loopback，只能填 tunnel 網址
SRC_API_URL=

# ── ADMIN_TOKEN（選填；消費者：compose/backend）
#   題庫寫入與 law-update 的管理權限。未設則寫入停用
ADMIN_TOKEN=

# ── CF_AIG_TOKEN（選填；消費者：compose/backend）
CF_AIG_TOKEN=

# ── HF_TOKEN（選填；消費者：compose/backend）
HF_TOKEN=

# ── NVIDIA_API_KEY（選填；消費者：compose/backend）
NVIDIA_API_KEY=

# ── TYPESAFE_API_KEY（選填；消費者：compose/backend）
TYPESAFE_API_KEY=

# ── ZEN_API_KEY（選填；消費者：compose/backend）
ZEN_API_KEY=

# ── ZEN_BASE_URL（選填；消費者：compose/backend）
ZEN_BASE_URL=

# ── OPENROUTER_GATEWAY_URL（選填；消費者：compose/backend）
OPENROUTER_GATEWAY_URL=

# ── JEV_VERIFY_MIN（選填；消費者：compose/backend）
JEV_VERIFY_MIN=

# ── JEV_BANK_MIN（選填；消費者：compose/backend）
JEV_BANK_MIN=

# ── 以下不該出現在 .env（2026-09-26 audit 確認無人讀）
# QDRANT_URLS: compose 只傳 QDRANT_URL=http://qdrant:6333（服務名解析），容器內讀不到 QDRANT_URLS；僅原生執行（不經 compose）時有效
# EMBED_MODEL: compose.yaml 直接寫死 bge-m3:latest，不從 .env 讀
# RERANK_MODEL: compose.yaml 直接寫死 qllama/bge-reranker-v2-m3:latest


