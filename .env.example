# .env.example — 三機共用的變數骨架
#
# 本檔由 `scripts/env-audit.py --template` 產生，**完全從程式碼反查**，
# 不含任何真實憑證，可安全進版控。改變數請改程式碼後重新產生。
#
# 填法：cp .env.example .env && chmod 600 .env，再逐項填值。
#
# 分類依據：
#   必填       compose 用 ${X:?}、Python 讀取時沒給預設值，
#              或是「預設值是別台機器的」（本機 HOST_ID 與預設不同時）
#   必填(憑證) 同上，且名稱含 KEY/SECRET/TOKEN/PASSWORD → 必須先填
#   選填       有預設值；不填就吃預設
#   憑證       選填的憑證類（一律 chmod 600）
#   未傳入容器  compose 沒列 environment: → .env 的值到不了容器，
#              要生效得改 compose.yaml
#   host 端    只有 ingest 管線／shell 腳本讀得到，容器本來就不需要
#   寫死       compose 用字面值覆蓋 → 這裡設了對容器無效
#
# 關於機台差異：per-host 的值**不在這個檔**填。
# 它們在 settings/env/hosts.shared.env（三台的 x570_/mbp_/msi_ 值同一個檔，
# 追蹤、明文、無憑證），由 scripts/env-sync.sh render 依本機 HOST_ID
# 挑列、展開 ${VAR} 後寫進 .env。
#
# 為什麼前綴不放進 .env：compose 只認 ${VAR}，沒有依 HOST_ID 動態選
# msi_/x570_ 的能力；前綴若寫在 .env，值會被 compose 讀不到而回退原始碼
# 預設（LLM_MODEL 掉回 14b、TS_IP 讓 ports: 綁錯而啟動失敗）—— 靜默劣化。
#
# 另一種把機台名放進變數名的寫法（同一台機器**同時**要有多組設定時用）：
#   HOST_API_X570 / HOST_API_MBP / HOST_API_MSI（rag.py:167-171）
#
# 各機怎麼認出自己的身份：HOST_ID（x570/mbp/msi）、TS_IP、
# HOST_NAME、HOST_MACHINE_ID —— 這四個每台不同。HOST_ID 是 render 的
# 選擇器，只能在 .env 手動設一次（要先知道本機是誰才挑得到列）。
# 注意 TS_IP 不是擺著就好：它用在 compose 的 ports:，
# 沒設會去 bind 預設值那台機器的 IP，docker 直接啟動失敗。
#
# ⚠️ 一律 chmod 600：.env 有憑證。
#

# ══ 必填 ══
# HOST_ID  —  消費者：compose/backend
#   預設值：x570
#   預設值屬別台機器，本機必須覆蓋
#   讀取處：compose.yaml:48, backend/app/rag.py:137, backend/app/registry.py:18
HOST_ID=

# OLLAMA_URLS  —  消費者：compose/backend
#   預設值：http://100.119.83.111:11434
#   預設值屬別台機器，本機必須覆蓋
#   讀取處：compose.yaml:38, backend/app/rag.py:34
OLLAMA_URLS=

# TS_IP  —  消費者：compose/backend/scripts
#   預設值：100.119.83.111
#   必填：用在 compose 的 ports:（綁定 IP），沒設會啟動失敗
#   讀取處：compose.yaml:9, compose.yaml:21, compose.yaml:67 …等 5 處
TS_IP=


# ══ 必填（含憑證） ══
# POSTGRES_PASSWORD  —  消費者：compose
#   必填：compose 用 ${...:?} 或 Python 讀取時沒給預設
#   讀取處：compose.yaml:24, compose.yaml:36
POSTGRES_PASSWORD=


