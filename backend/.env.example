# 本機開發用，不進版控
POSTGRES_PASSWORD=changeme

# ---- IP 準則（2026-09-22 定案，三台嚴格執行）----
# 一律只寫 tailscale IP（100.64.0.0/10）：TS_IP 必填、不用 LAN_IP、
# OLLAMA_URLS/QDRANT_URLS/POSTGRES_DSN 全部用 tailscale 位址。
# 唯一的例外是本機服務（本機 qdrant 備援 / x570 localhost）允許 127.0.0.1/localhost。
# registry._ips() 也會過濾成 tailscale 範圍，任何 LAN IP 不會進 registry /hosts。

# ---- 三機 profile ----
# HOST_ID 是 registry 主鍵，也是前端切換鍵值：x570 / mbp / msi
# OLLAMA_URLS / QDRANT_URLS 依優先序列候選，首位通連者快取，失敗自動降級

# [x570 .99] 主力
# HOST_ID=x570
# TS_IP=100.119.83.111
# OLLAMA_URLS=http://127.0.0.1:11434,http://100.119.83.111:11434
# QDRANT_URLS=http://localhost:6333
# POSTGRES_DSN=postgresql://rag:changeme@localhost:5432/ragdemo
# LLM_MODEL=qwen3:14b

# [mbp] 加速機
# HOST_ID=mbp
# TS_IP=100.64.121.9
# OLLAMA_URLS=http://127.0.0.1:11434,http://100.64.121.9:11434,http://100.119.83.111:11434
# QDRANT_URLS=http://100.119.83.111:6333,http://127.0.0.1:6333
# POSTGRES_DSN=postgresql://rag:changeme@100.119.83.111:5432/ragdemo
# LLM_MODEL=qwen3:14b

# [msi] demo 機（WSL，吃 Windows 本機 ollama）
# HOST_ID=msi
# TS_IP=100.65.68.106
# OLLAMA_URLS=http://100.65.68.106:11434,http://100.119.83.111:11434
# QDRANT_URLS=http://100.119.83.111:6333,http://127.0.0.1:6333
# POSTGRES_DSN=postgresql://rag:changeme@100.119.83.111:5432/ragdemo
# LLM_MODEL=qwen3:4b

LLM_MODEL=qwen3:14b
COLLECTION=laws