# 本機開發用，不進版控
POSTGRES_PASSWORD=changeme

# ---- 三機 profile ----
# HOST_ID 是 registry 主鍵，也是前端切換鍵值：linux / mbp / msi
# TS_IP / LAN_IP 參與 IP 清單與(/ 前端選址)，tailscale 優先
# OLLAMA_URLS / QDRANT_URLS 依優先序列候選，首位通連者快取，失敗自動降級

# [linux .99] 主力（tailscale + 區網都可通）
# HOST_ID=linux
# TS_IP=100.119.83.111
# LAN_IP=192.168.0.99
# OLLAMA_URLS=http://127.0.0.1:11434,http://100.119.83.111:11434,http://192.168.0.99:11434
# QDRANT_URLS=http://localhost:6333
# POSTGRES_DSN=postgresql://rag:changeme@localhost:5432/ragdemo
# LLM_MODEL=qwen3:14b

# [mbp] 加速機（只備 ollama；接手時自備 qdrant/pg）
# HOST_ID=mbp
# TS_IP=100.64.121.9
# LAN_IP=192.168.93.85
# OLLAMA_URLS=http://127.0.0.1:11434,http://100.64.121.9:11434,http://192.168.93.85:11434,http://100.119.83.111:11434,http://192.168.0.99:11434
# LLM_MODEL=qwen3:14b

# [msi] demo 機
# HOST_ID=msi
# TS_IP=100.65.68.106
# LAN_IP=192.168.0.2
# OLLAMA_URLS=http://127.0.0.1:11434,http://100.65.68.106:11434,http://192.168.0.2:11434,http://100.119.83.111:11434,http://192.168.0.99:11434
# LLM_MODEL=qwen3:4b

LLM_MODEL=qwen3:14b
COLLECTION=laws