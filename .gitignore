node_modules/
.svelte-kit/
.vite/
build/
__pycache__/
*.pyc
.venv/
*.egg-info/
.env
# env-sync 分層（settings/env/README.md）：解密暫存與明文 staging 絕不進版控。
# 注意：settings/env/secrets.*.enc.env 是「加密後」要追蹤的，故不在此列；
# settings/env/hosts.shared.env 是 per-host 值的唯一真相（追蹤、明文、無憑證）。
settings/env/.decrypted.*
settings/env/.init-secrets.*
settings/env/secrets.common.env
# per-host 機密的明文檔永不進版控（2026-09-27）：QDRANT_API_KEY /
# POSTGRES_PASSWORD 是各機自己容器的認證，沒有跨機讀寫關係，真值只留該機
# repo 根的 .env（chmod 600）。此行只擋不帶 .example 的那個，所以鍵名宣告檔
# settings/env/secrets.host.env.example 仍可追蹤（--check 的鍵覆蓋率要靠它）。
settings/env/secrets.host.env
# per-host 值只准放總表；任何另立的 per-host 檔都是第二真相，擋掉。
settings/env/hosts/
settings/env/hosts.local.env
*.log
.uvicorn.pid
dist/
.wrangler/
data/laws/*
!data/laws/.gitkeep

# law-update 執行狀態機（request/status 檔由 api 寫、host worker 讀寫）
data/.ops/

# Windows NTFS 替代資料流（ADS）。從 Windows 拖進來／解壓縮時會附帶
# 「檔名:Zone.Identifier」，內容只是來源路徑，無版本價值且會污染 git 狀態。
# 2026-09-27：files/ 進版控時清掉一批（docs/ 三份文件的 originals）。
*:Zone.Identifier
*:Zone.Identifier:*
