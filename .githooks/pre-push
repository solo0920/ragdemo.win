#!/usr/bin/env bash
# pre-push hook：git push 前的輕量 smoke（強制）+ 可選完整 HTTP smoke
#
# 強制（不通過就擋下 push）：
#   1) backend/app/*.py 語法檢查（ast.parse，不產 __pycache__）
#   2) IP 準則：被 git 追蹤的檔案不得出現 "LAN_IP=" 賦值（.env 不進版控抓不到，
#      但 .env.example / 文件若殘留 LAN_IP= 即違規）
#   3) pytest 單元測試（tests/，純函式不需外部服務；機器未裝 pytest 則跳過）
#   4) docker compose config -q（插值與 YAML 結構；docker 未裝則跳過）
# 可選（設 RAGDEMO_SMOKE=1 才跑，需本機 api 在線且 LLM 可用，較慢）：
#   5) 完整 HTTP smoke：/health + /query（驗證答案非空）
# 本機 api 不在線時：強制檢查照跑，HTTP 部分只警告不擋 push。
#
# 各機啟用：git config core.hooksPath .githooks
set -euo pipefail

echo "== pre-push smoke =="

# 1) Python 語法
#    用 find 而非 globstar：`backend/app/*.py` 只掃到第一層，common/ 等子目錄
#    裡的檔案會被漏掉（2026-09-29 補上，當時正好在切模組）。
fail=0
while IFS= read -r f; do
  python3 -c 'import ast,sys; ast.parse(open(sys.argv[1],"rb").read())' "$f" \
    || { echo "✗ 語法錯誤: $f"; fail=1; }
done < <(find backend/app -name '*.py' -type f | sort)
if [ "$fail" -ne 0 ]; then
  echo "✗ backend Python 語法檢查失敗，中止 push" >&2
  exit 1
fi
echo "✓ backend Python 語法 OK"

# 1b) shell 腳本語法
#     為什麼要加：scripts/ 下有 6 支會被三台直接執行的 shell（env-sync.sh 是
#     換憑證的必经之路），而 Python 語法檢查完全不管 .sh。一支壞掉的
#     env-sync.sh 症狀是「pull 失敗」——而 pull 失敗又被誤解成「私鑰不見了」
#     或「recipients 少了我的公鑰」（2026-09-30 msi 就走過那段誤診）。
#     語法錯要在這裡擋，而不是在別台機器上發現。
fail=0
while IFS= read -r f; do
  bash -n "$f" || { echo "✗ shell 語法錯誤: $f"; fail=1; }
done < <(find scripts .githooks -name '*.sh' -o -name 'pre-push' -o -name 'commit-msg' 2>/dev/null | sort -u)
if [ "$fail" -ne 0 ]; then
  echo "✗ shell 語法檢查失敗，中止 push" >&2
  exit 1
fi
echo "✓ shell 語法 OK"

# 2) IP 準則：追蹤檔案不得含 LAN_IP=
#
# ⚠️ 這裡**不能**寫成 `git grep -nE '^LAN_IP=' -- | grep -q .`。
# `grep -q` 找到第一筆就關管線 → `git grep` 收 SIGPIPE(141) → 在 `pipefail` 下
# 管線狀態變成 141 ≠ 0 → 走 else → **守衛靜默失效**。
#
# 而且失效條件很刁鑽：違規檔**夠多**時 git grep 還沒寫完就被關掉，狀態才是 141；
# 只有 1～3 檔時它來得及寫完、回 0，守衛照常觸發。所以一個只放一兩個違規檔的
# 測試**會通過**，看不出這個 bug —— 必須 400 檔以上才抓得到（實測確認）。
#
# 2026-09-30 實測（守衛失效的樣子）：
#   400 個違規檔 → 放行 ❌
#   3 個違規檔   → 擋下 ✅
# 症狀是綠的：push 成功、CI 也綠（CI 那份寫法沒有這條管線，所以 CI 一直是對的）。
#
# git grep 自己的 exit code 就夠判斷：0 = 有命中、1 = 沒有。
if LAN_HITS="$(git grep -nE '^LAN_IP=' -- 2>/dev/null)"; [ -n "$LAN_HITS" ]; then
  echo "✗ 追蹤檔案含 LAN_IP= 賦值（違反 IP 準則），移除後再 push" >&2
  # `|| true`：pipefail 下 head 讀完就關管線，printf 會收 SIGPIPE(141)，
  # 那會讓 set -e 在 exit 1 之前就中止，hook 以 141 而非 1 結束。擋下來的效果
  # 相同，但退出碼會誤導排查。
  printf '%s\n' "$LAN_HITS" | head -5 >&2 || true
  exit 1
fi
echo "✓ 無 LAN_IP= 殘留（IP 準則合規）"

# 3) pytest 單元測試（純函式，不需 api/docker；機器未裝 pytest 則跳過）
if [ -x .venv/bin/pytest ]; then
  .venv/bin/pytest -q -p no:cacheprovider >/dev/null 2>&1 \
    || { echo "✗ pytest 失敗，檢查 tests/ 後再 push" >&2; exit 1; }
  n=$(.venv/bin/pytest -q -p no:cacheprovider 2>/dev/null | tail -1 | grep -oE '^[0-9]+ passed' | grep -oE '[0-9]+')
  echo "✓ pytest ${n:-?} passed"
else
  echo "⚠ pytest 未安裝（uv sync --dev 後啟用），跳過單元測試"
fi

# 4) compose 插值與結構
#    為什麼要加（2026-09-30）：CI 的 `compose config` 從 09-27 起連續紅了 10 次
#    push 而沒有人發現 —— 因為那個 job 缺 HOST_ID，而**本機 pre-push 沒有這道
#    檢查**，所以按 push 的那一側全程看不見。CI 連續紅等於沒有 CI：它的存在
#    意義是「三機紀律的公開證據」，而大家只看本機 pre-push 綠就把信寄出去。
#    把同一道檢查搬到本機，那種缺口就在按鈕那一側被擋住。
#
#    -q（quiet）只做驗證不印展開後的設定。實測過：失敗訊息裡出現的是變數名
#    與格式錯誤（`invalid IP address: …`），**不會印出 .env 的值**（2026-09-30
#    用真正的 32 字元密碼驗過，出現 0 次），所以輸出可以直接轉發。
#    不是 -q 就會把整份展開後的設定印出來，那包含明文密碼。
if command -v docker >/dev/null 2>&1; then
  if out="$(docker compose config -q 2>&1)"; then
    echo "✓ compose 插值 OK"
  else
    echo "✗ docker compose config 失敗，中止 push" >&2
    printf '%s\n' "$out" | head -10 >&2
    echo "  （若缺 .env 造成，先 cp .env.example .env 補齊）" >&2
    exit 1
  fi
else
  echo "⚠ docker 未安裝，跳過 compose 插值檢查"
fi

# 5) 可選完整 HTTP smoke
if [ "${RAGDEMO_SMOKE:-0}" = "1" ]; then
  if ! curl -sf -m 5 http://localhost:8000/health >/dev/null 2>&1; then
    echo "✗ RAGDEMO_SMOKE=1 但本機 api(localhost:8000) 不在線，中止 push" >&2
    exit 1
  fi
  ans="$(curl -s -m 120 http://localhost:8000/query -H 'content-type: application/json' \
    -d '{"question":"契約解除後雙方有何回復原狀義務？"}' \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d.get("answer","")))' 2>/dev/null || echo 0)"
  if [ "${ans:-0}" -gt 0 ]; then
    echo "✓ HTTP smoke: /query 答案 ${ans} chars"
  else
    echo "✗ HTTP smoke: /query 回空/異常，中止 push" >&2
    exit 1
  fi
else
  if curl -sf -m 3 http://localhost:8000/health >/dev/null 2>&1; then
    echo "✓ 本機 api OK（完整 smoke 可加 RAGDEMO_SMOKE=1 跑 /query）"
  else
    echo "⚠ 本機 api 不在線，跳過 HTTP smoke（push 照常）"
  fi
fi

echo "== pre-push smoke 通過 =="
exit 0