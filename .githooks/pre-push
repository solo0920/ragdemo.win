#!/usr/bin/env bash
# pre-push hook：git push 前的輕量 smoke（強制）+ 可選完整 HTTP smoke
#
# 強制（不通過就擋下 push）：
#   1) backend/app/*.py 語法檢查（ast.parse，不產 __pycache__）
#   2) IP 準則：被 git 追蹤的檔案不得出現 "LAN_IP=" 賦值（.env 不進版控抓不到，
#      但 .env.example / 文件若殘留 LAN_IP= 即違規）
#   3) pytest 單元測試（tests/，純函式不需外部服務；機器未裝 pytest 則跳過）
#   4) docker compose config -q（插值與 YAML 結構；docker 未裝則跳過）
# 可選（設 RAGDEMO_SMOKE=1 才跑，需本機 api 在線且 LLM 可用，較慢）：
#   5) 完整 HTTP smoke：/health + /query（驗證答案非空）
# 本機 api 不在線時：強制檢查照跑，HTTP 部分只警告不擋 push。
#
# 各機啟用：git config core.hooksPath .githooks
set -euo pipefail

echo "== pre-push smoke =="

# 1) Python 語法
#    用 find 而非 globstar：`backend/app/*.py` 只掃到第一層，common/ 等子目錄
#    裡的檔案會被漏掉（2026-09-29 補上，當時正好在切模組）。
fail=0
while IFS= read -r f; do
  python3 -c 'import ast,sys; ast.parse(open(sys.argv[1],"rb").read())' "$f" \
    || { echo "✗ 語法錯誤: $f"; fail=1; }
done < <(find backend/app -name '*.py' -type f | sort)
if [ "$fail" -ne 0 ]; then
  echo "✗ backend Python 語法檢查失敗，中止 push" >&2
  exit 1
fi
echo "✓ backend Python 語法 OK"

# 1b) shell 腳本語法
#     為什麼要加：scripts/ 下有 6 支會被三台直接執行的 shell（env-sync.sh 是
#     換憑證的必经之路），而 Python 語法檢查完全不管 .sh。一支壞掉的
#     env-sync.sh 症狀是「pull 失敗」——而 pull 失敗又被誤解成「私鑰不見了」
#     或「recipients 少了我的公鑰」（2026-09-30 msi 就走過那段誤診）。
#     語法錯要在這裡擋，而不是在別台機器上發現。
fail=0
while IFS= read -r f; do
  bash -n "$f" || { echo "✗ shell 語法錯誤: $f"; fail=1; }
done < <(find scripts .githooks -name '*.sh' -o -name 'pre-push' -o -name 'commit-msg' 2>/dev/null | sort -u)
if [ "$fail" -ne 0 ]; then
  echo "✗ shell 語法檢查失敗，中止 push" >&2
  exit 1
fi
echo "✓ shell 語法 OK"

# 2) IP 準則：追蹤檔案不得含 LAN_IP=
#
# ⚠️ 這裡**不能**寫成 `git grep -nE '^LAN_IP=' -- | grep -q .`。
# `grep -q` 找到第一筆就關管線 → `git grep` 收 SIGPIPE(141) → 在 `pipefail` 下
# 管線狀態變成 141 ≠ 0 → 走 else → **守衛靜默失效**。
#
# 而且失效條件很刁鑽：違規檔**夠多**時 git grep 還沒寫完就被關掉，狀態才是 141；
# 只有 1～3 檔時它來得及寫完、回 0，守衛照常觸發。所以一個只放一兩個違規檔的
# 測試**會通過**，看不出這個 bug —— 必須 400 檔以上才抓得到（實測確認）。
#
# 2026-09-30 實測（守衛失效的樣子）：
#   400 個違規檔 → 放行 ❌
#   3 個違規檔   → 擋下 ✅
# 症狀是綠的：push 成功、CI 也綠（CI 那份寫法沒有這條管線，所以 CI 一直是對的）。
#
# git grep 自己的 exit code 就夠判斷：0 = 有命中、1 = 沒有。
if LAN_HITS="$(git grep -nE '^LAN_IP=' -- 2>/dev/null)"; [ -n "$LAN_HITS" ]; then
  echo "✗ 追蹤檔案含 LAN_IP= 賦值（違反 IP 準則），移除後再 push" >&2
  # `|| true`：pipefail 下 head 讀完就關管線，printf 會收 SIGPIPE(141)，
  # 那會讓 set -e 在 exit 1 之前就中止，hook 以 141 而非 1 結束。擋下來的效果
  # 相同，但退出碼會誤導排查。
  printf '%s\n' "$LAN_HITS" | head -5 >&2 || true
  exit 1
fi
echo "✓ 無 LAN_IP= 殘留（IP 準則合規）"

# 3) pytest 單元測試（純函式，不需 api/docker；機器未裝 pytest 則跳過）
if [ -x .venv/bin/pytest ]; then
  # 2026-10-02：把「跑不起來」的原因講清楚，不要只說「pytest 失敗」。
  # 實測踩到的最常見一種：repo 目錄改名／搬移後，.venv 裡每個 script 的
  # shebang 還是舊絕對路徑 → `bad interpreter`。而 uv sync --dev 修不好它
  # （pyvenv.cfg 的 home 是可攜的，uv 判定 venv 已是最新），所以要重建。
  # 症狀與「沒裝 pytest」不同，誤判成後者會得到「我明明 sync 過了」。
  if ! out="$(.venv/bin/pytest --version 2>&1)"; then
    echo "✗ .venv/bin/pytest 跑不起來（不是測試失敗，是環境壞掉）：" >&2
    printf '%s\n' "$out" | head -3 >&2
    case "$out" in
      *"bad interpreter"*)
        echo "  診斷：repo 目錄改名／搬移過，.venv 內的絕對路徑過期。" >&2
        echo "  ** uv sync --dev 修不好這個 **（它認為 venv 已是最新）。修法：" >&2
        echo "      rm -rf .venv && uv sync --dev" >&2
        echo "  細節見 HOST-UPGRADE.md〈repo 目錄改名／搬移後〉。" >&2
        ;;
      *"No module named pytest"*)
        echo "  診斷：venv 裡沒有 pytest。修法：uv sync --dev" >&2
        ;;
      *)
        echo "  診斷：見上面那行訊息。" >&2
        ;;
    esac
    exit 1
  fi
  # ⚠️ 2026-10-03：這裡原本**跑兩次** pytest —— 第 101 行為了退出碼（輸出丟進
  #    /dev/null），第 103 行又跑一次只為了數 `passed`。實測 pre-push 要 51 秒，
  #    其中 48 秒是這兩次。單元測試是這條 hook 最貴的一段，沒有理由付兩倍。
  #
  #    順帶修掉一個更煩的：原本失敗時輸出被丟掉，只印「檢查 tests/ 後再 push」。
  #    那句話把診斷責任推給人，而**失敗訊息就在手邊** —— 印出來才是響亮失敗。
  #    （不會洩漏憑證：那些測試本身就在斷言產出不含憑證值。）
  _pt="$(mktemp)"
  trap 'rm -f "$_pt"' EXIT
  if .venv/bin/pytest -q -p no:cacheprovider >"$_pt" 2>&1; then
    n=$(tail -1 "$_pt" | grep -oE '^[0-9]+ passed' | grep -oE '[0-9]+')
    echo "✓ pytest ${n:-?} passed"
  else
    echo "✗ pytest 失敗，以下是尾段（完整輸出：.git/pre-push-pytest.log）" >&2
    tail -25 "$_pt" | sed 's/^/    /' >&2
    cp "$_pt" .git/pre-push-pytest.log
    exit 1
  fi
else
  echo "⚠ pytest 未安裝（uv sync --dev 後啟用），跳過單元測試"
fi

# 4) compose 插值與結構
#    為什麼要加（2026-09-30）：CI 的 `compose config` 從 09-27 起連續紅了 10 次
#    push 而沒有人發現 —— 因為那個 job 缺 HOST_ID，而**本機 pre-push 沒有這道
#    檢查**，所以按 push 的那一側全程看不見。CI 連續紅等於沒有 CI：它的存在
#    意義是「三機紀律的公開證據」，而大家只看本機 pre-push 綠就把信寄出去。
#    把同一道檢查搬到本機，那種缺口就在按鈕那一側被擋住。
#
#    -q（quiet）只做驗證不印展開後的設定。實測過：失敗訊息裡出現的是變數名
#    與格式錯誤（`invalid IP address: …`），**不會印出 .env 的值**（2026-09-30
#    用真正的 32 字元密碼驗過，出現 0 次），所以輸出可以直接轉發。
#    不是 -q 就會把整份展開後的設定印出來，那包含明文密碼。
if command -v docker >/dev/null 2>&1; then
  if out="$(docker compose config -q 2>&1)"; then
    echo "✓ compose 插值 OK"
  else
    echo "✗ docker compose config 失敗，中止 push" >&2
    printf '%s\n' "$out" | head -10 >&2
    echo "  （若缺 .env 造成，先 cp .env.example .env 補齊）" >&2
    exit 1
  fi
else
  echo "⚠ docker 未安裝，跳過 compose 插值檢查"
fi

# 5) 可選完整 HTTP smoke
#
# ⚠️ 2026-10-03：這裡原本**寫死 `localhost:8000`**（4 處）。換埠到 920 之後
#    症狀是**假陰性**：`RAGDEMO_SMOKE=1` 永遠報「api 不在線」而中止 push ——
#    等於「驗證答案非空」那道檢查**從此沒跑過**。
#    而在 mbp 上它會變成**假陽性**：omlx 搶先綁 8000 時，`/health` 會回 200，
#    於是印「✓ 本機 api OK」—— 那正是 `api-identity` 那個病（比報錯更糟）。
#
#    ⚠️ 這裡**刻意不寫預設埠**。寫死就會是第三份副本（compose 已經有一份），
#    而換埠時它就是「靜默指向舊埠」的來源。取不到就**明確失敗**。
if [ "${RAGDEMO_SMOKE:-0}" = "1" ]; then
  _smoke_port=""
  if [ -f .env ]; then
    _smoke_port="$(sed -n 's/^API_PORT=//p' .env | tail -1 | tr -d ' \r')"
  fi
  # ⚠️ 上面那條管線的 `|| true` **不是多餘的**（2026-10-05 實測踩到）：
    #   容器不在時 `docker compose ps` 沒有任何輸出 → `grep -oE` 找不到東西回 **1**
    #   → `set -o pipefail` 把那個 1 傳成整條管線的結果 → 指派行回 1
    #   → **`set -e` 整支腳本靜默死掉**。
    #   症狀：pre-push 在最後一項之後**沒有任何訊息**就 exit 1，而 push 端只看到
    #   「error: failed to push some refs」—— 與 `ch_api_port_owner` 裡 `lsof`
    #   那個 `|| true` 是同一類問題（沒有依據的「防禦性寫法」其實是必需品）。
    if [ -z "$_smoke_port" ] && command -v docker >/dev/null 2>&1; then
    # 從**現實**反查（不是從常數）：compose 實際發布的那個埠。
    # ⚠️ 只用 `--format '{{.Publishers}}'`（**欄位受限**，只印一個欄位）。
    #    別改成 `--format json` —— 實測它會帶出 `Command` 欄位，而 argv 在
    #    別的设置裡可能帶明文密碼。那正是 `docker compose config -q` 那條
    #    守衛要防的事，`ps` 也一樣。
    _smoke_port="$(docker compose ps --format '{{.Publishers}}' api 2>/dev/null \
      | grep -oE '[0-9]+ +[0-9]+ +tcp' | head -1 | awk '{print $1}' || true)"
  fi
  if [ -z "$_smoke_port" ]; then
    echo "✗ 拿不到本機 api 的主機埠 —— 中止 push（不猜預設值）" >&2
    echo "  取值順序：.env 的 API_PORT → docker compose ps 實際發布的埠。" >&2
    echo "  兩個都拿不到通常是 api 容器沒起來；**不要**在這裡加預設埠 ——" >&2
    echo "  那會是第三份副本，換埠時就會靜默指向舊埠。" >&2
    exit 1
  fi
  _smoke_base="http://127.0.0.1:${_smoke_port}"
  if ! curl -sf -m 5 "$_smoke_base/health" >/dev/null 2>&1; then
    echo "✗ RAGDEMO_SMOKE=1 但本機 api(${_smoke_base}) 不在線，中止 push" >&2
    exit 1
  fi
  ans="$(curl -s -m 120 "$_smoke_base/query" -H 'content-type: application/json' \
    -d '{"question":"契約解除後雙方有何回復原狀義務？"}' \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d.get("answer","")))' 2>/dev/null || echo 0)"
  if [ "${ans:-0}" -gt 0 ]; then
    echo "✓ HTTP smoke(${_smoke_base}): /query 答案 ${ans} chars"
  else
    echo "✗ HTTP smoke: /query 回空/異常，中止 push" >&2
    exit 1
  fi
else
  # 一樣不寫死：非 smoke 分支只做「在不在線」的低成本檢查。它若寫死 8000，
  # 在 mbp 上會替 omlx 開綠燈 —— 那是比報錯更糟的失敗。
  _probe_port=""
  if [ -f .env ]; then
    _probe_port="$(sed -n 's/^API_PORT=//p' .env | tail -1 | tr -d ' \r')"
  fi
  if [ -z "$_probe_port" ] && command -v docker >/dev/null 2>&1; then
    # 一樣欄位受限（見上面 smoke 分支的說明）：不用 `--format json`。
    #
    # ⚠ 2026-10-10：**這裡原來寫的樣式 `[0-9]+ +[0-9]+ +tcp` 抓不到東西。**
    #   Docker Compose v5.6.0 的 `{{.Publishers}}` 實際印的是
    #     `[920/tcp -> 127.0.0.1:920]`
    #   `920` 與 `tcp` 之間有斜線，`[0-9]+ +[0-9]+ +tcp` 匹配不上 →
    #   取不到埠 → 下面印「讀不到 docker」——**那句話是錯的**，docker 明明有回應，
    #   是這個樣式沒解析出來。使用者回報這是「沒意義又誤導的訊息」。
    #   改成抓發布端的 `主機:埠`，那才是我們要的（主機端埠，不是容器內埠）。
    #   實測：舊樣式無輸出；新樣式 [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+ → 920 ✓
    _probe_port="$(docker compose ps --format '{{.Publishers}}' api 2>/dev/null \
      | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+' | head -1 | awk -F: '{print $NF}' || true)"
  fi
  if [ -z "$_probe_port" ]; then
    # 2026-10-10：**靜默**。這整個 else 分支不擋 push（沒有任何 exit），
    #   所以「拿不到埠」不是一個需要使用者行動的問題 —— 印出來只會讓人
    #   以為 push 出了事。舊訊息還寫「讀不到 docker」，但 docker 其實有回應，
    #   是樣式沒匹配上，那更是誤導。
    #   要跑真正會擋 push 的完整檢查 → RAGDEMO_SMOKE=1（那條分支失敗會 exit 1）。
    #   要看這台的 api 狀態 → scripts/host-check.sh 或 curl /health。
    :
  elif curl -sf -m 3 "http://127.0.0.1:${_probe_port}/health" >/dev/null 2>&1; then
    # 在線才講。離線時同樣靜默 —— 它不擋 push，不是使用者要處理的事。
    echo "✓ 本機 api OK（:${_probe_port}，完整 smoke 可加 RAGDEMO_SMOKE=1 跑 /query）"
  fi
fi

echo "== pre-push smoke 通過 =="
exit 0