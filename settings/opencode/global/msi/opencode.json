{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://gateway.ai.cloudflare.com/v1/e91bd59a03f8647cc73d2fb87e07014d/cloudflaregateway/openrouter",
        "apiKey": "{file:/home/solo/.config/opencode/cf-aig-token}",
        "headers": {
          "cf-aig-authorization": "Bearer {file:/home/solo/.config/opencode/cf-aig-token}"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:/home/solo/.config/opencode/gh-token}",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,code_security,dependabot,secret_protection,governance"
        }
      }
    }
  }
}