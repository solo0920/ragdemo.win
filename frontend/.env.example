# Google OAuth（「使用 Google 登入」）
# 1. console.cloud.google.com 建立 OAuth Client（Web application，類型選「網頁應用程式」）
# 2. 授權的重導 URI 需含：http://localhost:5173/auth/callback、https://ragdemo.win/auth/callback
#    （每台可能要 demo 的 origin 都要先登記）
# 3. 把 Client ID / Client Secret 填進本檔（dev 用）；上線用 Cloudflare Pages 環境變數
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# session cookie 簽章金鑰（>=32 字元、亂數、勿外洩）
SESSION_SECRET=